# Symbols that MUST end up as stated in the resolved .config (checked by scripts/build-kernel after olddefconfig).
# Grammar: SYM = must be =y | SYM=VALUE = exact value | !SYM = must be unset.
# Without them a lab host is unreachable or invisible, so a silent Kconfig drop is a build failure (review F-F18).
# NICs
E1000
E1000E
IGB
IGC
IXGBE
R8169
TIGON3
BNX2
BNXT
VIRTIO_NET
VMXNET3
USB_RTL8152
USB_NET_AX88179_178A
USB_NET_CDCETHER
USB_NET_CDC_NCM
PACKET
VLAN_8021Q
# boot and storage
EFI_STUB
BLK_DEV_INITRD
RD_ZSTD
DEVTMPFS
BLK_DEV_NVME
SATA_AHCI
BLK_DEV_SD
BLK_DEV_SR
USB_STORAGE
USB_XHCI_HCD
USB_XHCI_PCI
USB_EHCI_PCI
VIRTIO_BLK
ISO9660_FS
VFAT_FS
EXT4_FS
# console
SERIAL_8250_CONSOLE
VT_CONSOLE
DRM_SIMPLEDRM
UNIX98_PTYS
# hardening (70-hardening.config): the build FAILS if any of these is dropped
RANDOMIZE_BASE
RANDOMIZE_MEMORY
STACKPROTECTOR_STRONG
VMAP_STACK
RANDOMIZE_KSTACK_OFFSET_DEFAULT
STRICT_KERNEL_RWX
STRICT_MODULE_RWX
HARDENED_USERCOPY
FORTIFY_SOURCE
INIT_ON_ALLOC_DEFAULT_ON
SLAB_FREELIST_RANDOM
SLAB_FREELIST_HARDENED
SHUFFLE_PAGE_ALLOCATOR
LIST_HARDENED
BUG_ON_DATA_CORRUPTION
STRICT_DEVMEM
IO_STRICT_DEVMEM
DEFAULT_MMAP_MIN_ADDR=65536
LEGACY_VSYSCALL_NONE
!DEBUG_FS
!COMPAT_BRK
!PROC_KCORE
# kexec is deliberately on (the later kexec command needs it); do not remove it silently
KEXEC
# the kernel image stays small: drivers beyond these are modules
MODULES
FW_LOADER_COMPRESS_ZSTD
