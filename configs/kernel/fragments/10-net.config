# 10-net.config: kernel fragment (owner: P10). NIC policy (PLAN section 7, review F-F18): every NIC of the hardware
# list is =y, because a lab host whose NIC driver is a missing module is unreachable. scripts/build-kernel also checks
# configs/kernel/must-be-y.list. Firmware-needing NICs get their blobs from configs/image/firmware.list.
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_VLAN_8021Q=y
CONFIG_BRIDGE=y
CONFIG_TUN=y
CONFIG_VETH=y
CONFIG_DUMMY=y
CONFIG_BONDING=m
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NETCONSOLE=y
CONFIG_NETCONSOLE_DYNAMIC=y
CONFIG_PHYLIB=y
CONFIG_REALTEK_PHY=y
# Intel
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_IGC=y
CONFIG_IXGBE=y
CONFIG_I40E=m
CONFIG_ICE=m
# Realtek (r8169 covers RTL8111/8168/8125/8126)
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=y
# Broadcom
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_TIGON3=y
CONFIG_BNX2=y
CONFIG_BNXT=y
CONFIG_BNX2X=m
# Mellanox
CONFIG_NET_VENDOR_MELLANOX=y
CONFIG_MLX4_EN=m
CONFIG_MLX5_CORE=m
CONFIG_MLX5_CORE_EN=y
# virtual NICs (QEMU/VMware)
CONFIG_VIRTIO_NET=y
CONFIG_VMXNET3=y
# USB Ethernet adapters (what a person plugs in when the onboard NIC has no driver)
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_RTL8152=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_CDC_EEM=y
# NetFilter and traffic shaping stay off: nothing in the image uses them
# CONFIG_NETFILTER is not set
# CONFIG_NET_SCHED is not set
