# 10-net.config: kernel fragment (owner: P10). NIC policy (PLAN section 7, review F-F18): every core NIC of the hardware
# list is =y, because a lab host whose NIC driver is a missing module is unreachable. scripts/build-kernel also checks
# configs/kernel/must-be-y.list. Firmware-needing NICs get their blobs from configs/firmware-lean.list / firmware-full.exclude.
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_VLAN_8021Q=y
CONFIG_BRIDGE=y
CONFIG_TUN=y
CONFIG_VETH=y
CONFIG_DUMMY=y
CONFIG_BONDING=m
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NETCONSOLE=y
CONFIG_NETCONSOLE_DYNAMIC=y
CONFIG_PHYLIB=y
CONFIG_REALTEK_PHY=y
# Intel
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_IGC=y
CONFIG_IXGBE=y
CONFIG_I40E=m
CONFIG_ICE=m
# Realtek (r8169 covers RTL8111/8168/8125/8126)
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=y
# Broadcom
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_TIGON3=y
CONFIG_BNX2=y
CONFIG_BNXT=y
CONFIG_BNX2X=m
# Mellanox
CONFIG_NET_VENDOR_MELLANOX=y
CONFIG_MLX4_EN=m
CONFIG_MLX5_CORE=m
CONFIG_MLX5_CORE_EN=y
# virtual NICs (QEMU/VMware)
CONFIG_VIRTIO_NET=y
CONFIG_VMXNET3=y
# USB Ethernet adapters (what a person plugs in when the onboard NIC has no driver)
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_RTL8152=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_CDC_EEM=y
# NetFilter and traffic shaping stay off: nothing in the image uses them
# CONFIG_NETFILTER is not set
# CONFIG_NET_SCHED is not set
# ---- broad coverage as MODULES (operator 2026-11-13): the initramfs carries modules.alias and i7lab-init loads by modalias.
# Intel extras
CONFIG_IXGBEVF=m
CONFIG_IGBVF=m
CONFIG_I40EVF=m
CONFIG_IAVF=m
# Realtek: r8169 (=y above) drives RTL8111/8168/8125/8126 in-tree; rtase = RTL907x/RTL8126-class PCIe
CONFIG_8139TOO=m
CONFIG_8139CP=m
CONFIG_RTASE=m
# Broadcom / Marvell / Atheros / NVIDIA / Aquantia / Solarflare
CONFIG_NET_VENDOR_MARVELL=y
CONFIG_SKGE=m
CONFIG_SKY2=m
CONFIG_NET_VENDOR_ATHEROS=y
CONFIG_ALX=m
CONFIG_ATL1C=m
CONFIG_ATL1E=m
CONFIG_ATL1=m
CONFIG_ATL2=m
CONFIG_NET_VENDOR_AQUANTIA=y
CONFIG_AQTION=m
CONFIG_NET_VENDOR_SOLARFLARE=y
CONFIG_SFC=m
CONFIG_NET_VENDOR_NVIDIA=y
CONFIG_FORCEDETH=m
CONFIG_MLX4_CORE=m
# hypervisor NICs: virtio/vmxnet3 are =y above; Hyper-V and Xen guests get modules
CONFIG_HYPERV=y
CONFIG_HYPERV_NET=m
CONFIG_XEN=y
CONFIG_XEN_NETDEV_FRONTEND=m
# USB NICs beyond the =y set above (r8152, asix, ax88179, cdc_ether, cdc_ncm are built in)
CONFIG_USB_NET_CDC_MBIM=m
CONFIG_USB_LAN78XX=m
CONFIG_USB_NET_SMSC95XX=m
CONFIG_USB_NET_SMSC75XX=m
CONFIG_USB_NET_RNDIS_HOST=m
# virtual links
CONFIG_MACVLAN=m
CONFIG_IPVLAN=m
CONFIG_VXLAN=m
CONFIG_NET_TEAM=m
