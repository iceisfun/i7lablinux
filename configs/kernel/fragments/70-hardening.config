# 70-hardening.config: kernel fragment (owner: P10). Hardening for a network-facing lab image (operator 2026-11-13).
# Every symbol here must survive olddefconfig (build-kernel checks), and the important ones are repeated in
# configs/kernel/must-be-y.list so dropping a line here still fails the build.
# Deliberate lab-image exceptions (documented, not hardened): /dev/mem + /dev/port exist (but STRICT_DEVMEM + IO_STRICT_DEVMEM
# restrict them, see 00-core), KEXEC is enabled for the planned kexec command (no signed-kexec enforcement: we sign no kernels),
# module signing is off (MODULE_SIG not set: the initramfs is the trust root, modules are not loaded from disk).
# --- memory layout and stack
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_VMAP_STACK=y
CONFIG_RANDOMIZE_KSTACK_OFFSET=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_SCHED_STACK_END_CHECK=y
# --- W^X
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_DEBUG_WX=y
# --- usercopy, fortify, heap
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_LIST_HARDENED=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
# --- user-space visible attack surface
CONFIG_DEFAULT_MMAP_MIN_ADDR=65536
CONFIG_LEGACY_VSYSCALL_NONE=y
# CONFIG_COMPAT_BRK is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_BLK_DEV_IO_TRACE is not set
# CONFIG_PROC_KCORE is not set
# CONFIG_X86_IOPL_IOPERM is not set
CONFIG_SECURITY_DMESG_RESTRICT=y
# CONFIG_ACPI_CUSTOM_METHOD is not set
# CONFIG_ACPI_TABLE_UPGRADE is not set
