# 20-storage.config: kernel fragment (owner: P10). Everything that can hold a disk the lab wants to test is =y;
# big server HBAs are modules (listed in configs/image/modules.list when wanted).
CONFIG_BLOCK=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y
CONFIG_NVME_HWMON=y
CONFIG_ATA=y
CONFIG_ATA_SFF=y
CONFIG_ATA_BMDMA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_ATA_GENERIC=y
CONFIG_PATA_AMD=y
CONFIG_PATA_OLDPIIX=y
CONFIG_PATA_SCH=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_CHR_DEV_SG=y
CONFIG_BLK_DEV_BSG=y
CONFIG_SCSI_SCAN_ASYNC=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_VIRTIO_BLK=y
CONFIG_SCSI_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_MEGARAID_SAS=m
CONFIG_SCSI_MPT3SAS=m
CONFIG_SCSI_HPSA=m
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_BSG_COMMON=y
# CONFIG_BLK_DEV_DM is not set
# CONFIG_MD is not set
# ---- broad coverage as MODULES (operator 2026-11-13)
CONFIG_SCSI_AACRAID=m
CONFIG_SCSI_SMARTPQI=m
CONFIG_SCSI_ISCI=m
CONFIG_SCSI_MPI3MR=m
CONFIG_SCSI_FC_ATTRS=m
CONFIG_SCSI_QLA_FC=m
CONFIG_SCSI_LPFC=m
CONFIG_BLK_DEV_3W_XXXX_RAID=m
CONFIG_SCSI_3W_9XXX=m
CONFIG_SCSI_3W_SAS=m
CONFIG_SCSI_ARCMSR=m
CONFIG_SCSI_ADVANSYS=m
CONFIG_SCSI_AIC94XX=m
CONFIG_MEGARAID_NEWGEN=y
CONFIG_MEGARAID_MM=m
CONFIG_MEGARAID_MAILBOX=m
CONFIG_VMD=m
CONFIG_SATA_NV=m
CONFIG_SATA_SIL=m
CONFIG_SATA_SIL24=m
CONFIG_SATA_VIA=m
CONFIG_SATA_SIS=m
CONFIG_SATA_SVW=m
CONFIG_SATA_ULI=m
CONFIG_SATA_MV=m
CONFIG_SATA_PROMISE=m
CONFIG_SATA_SX4=m
CONFIG_SATA_ACARD_AHCI=m
CONFIG_PATA_JMICRON=m
CONFIG_PATA_MARVELL=m
CONFIG_PATA_VIA=m
CONFIG_PATA_SIS=m
CONFIG_PATA_ATIIXP=m
CONFIG_PATA_PDC2027X=m
CONFIG_PATA_ACPI=m
CONFIG_MMC_SDHCI_ACPI=m
CONFIG_MMC_RICOH_MMC=y
CONFIG_MISC_RTSX_PCI=m
CONFIG_MMC_REALTEK_PCI=m
CONFIG_MISC_RTSX_USB=m
CONFIG_MMC_REALTEK_USB=m
CONFIG_MMC_USHC=m
