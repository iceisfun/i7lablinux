# 00-core.config: kernel fragment (owner: P10). Merged in name order by scripts/build-kernel on top of x86_64_defconfig.
# Every symbol listed here must survive olddefconfig (build-kernel checks and fails otherwise).
# Initramfs-only system: everything needed to boot and reach the network is built in (=y).
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=512
CONFIG_LOCALVERSION="-i7lab"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="i7lab"
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_PANIC_TIMEOUT=10
# --- boot, firmware, platform
CONFIG_ACPI=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCIEAER=y
CONFIG_PCIEASPM=y
CONFIG_PCI_IOV=y
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_PCIE=y
CONFIG_INTEL_IOMMU=y
CONFIG_AMD_IOMMU=y
CONFIG_DMI=y
CONFIG_DMIID=y
CONFIG_DMI_SYSFS=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_RTC_CLASS=y
CONFIG_HPET_TIMER=y
CONFIG_X86_X2APIC=y
CONFIG_KEXEC=y
# --- initramfs
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# --- what i7lab-init / i7labd / i7labsh need from the kernel
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_UNIX=y
CONFIG_UNIX98_PTYS=y
# CONFIG_LEGACY_PTYS is not set
CONFIG_TTY=y
CONFIG_INOTIFY_USER=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_FUTEX=y
CONFIG_HW_RANDOM=y
# --- probing: /dev/mem and /dev/port are deliberate on a lab image
CONFIG_DEVMEM=y
# CONFIG_STRICT_DEVMEM is not set
CONFIG_DEVPORT=y
# --- modules (Wi-Fi, big HBAs, rare NICs). Plain .ko: the initramfs is compressed as a whole, i7lab-init needs no decompressor.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# CONFIG_MODULE_COMPRESS is not set
# CONFIG_MODULE_SIG is not set
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
# --- running inside QEMU/KVM (the e2e tests): paravirt clock, console
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
