# 90-size-trim.config: kernel fragment (owner: P10). Last in the merge: turns off what a headless probe image does not
# need (smaller, less attack surface). "is not set" lines are advisory: if Kconfig forces one on, build-kernel warns.
# CONFIG_SOUND is not set
# CONFIG_BT is not set
# CONFIG_VIRTUALIZATION is not set
# CONFIG_DRM_I915 is not set
# CONFIG_DRM_AMDGPU is not set
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_DRM_RADEON is not set
# CONFIG_SECURITY_SELINUX is not set
# CONFIG_AUDIT is not set
# CONFIG_HIBERNATION is not set
# CONFIG_PROFILING is not set
# CONFIG_DEBUG_INFO_BTF is not set
CONFIG_DEBUG_INFO_NONE=y
