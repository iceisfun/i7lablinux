# 40-fs.config: kernel fragment (owner: P10). The image is an initramfs; these are for inspecting what is on the
# host's disks (read-mostly) and for the boot media itself (FAT ESP, ISO9660 for JetKVM CD mode).
CONFIG_EXT4_FS=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_CONFIGFS_FS=y
CONFIG_NTFS3_FS=m
CONFIG_XFS_FS=m
CONFIG_BTRFS_FS=m
CONFIG_EXFAT_FS=m
CONFIG_UDF_FS=m
# CONFIG_FUSE_FS is not set
# CONFIG_NFS_FS is not set
CONFIG_F2FS_FS=m
CONFIG_EXT4_FS_POSIX_ACL=y
