# 50-probe-hw.config: kernel fragment (owner: P10). Interfaces the probes read: hwmon, thermal, MSR/CPUID, EDAC, IPMI,
# watchdogs. Names are for 6.18; build-kernel fails on any that disappear.
CONFIG_HWMON=y
CONFIG_THERMAL=y
CONFIG_THERMAL_HWMON=y
CONFIG_ACPI_THERMAL=y
CONFIG_ACPI_FAN=y
CONFIG_X86_PKG_TEMP_THERMAL=y
CONFIG_SENSORS_CORETEMP=y
CONFIG_SENSORS_K10TEMP=y
CONFIG_SENSORS_DRIVETEMP=y
CONFIG_SENSORS_IT87=m
CONFIG_SENSORS_NCT6775=m
CONFIG_POWERCAP=y
CONFIG_INTEL_RAPL=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_X86_MSR=y
CONFIG_X86_CPUID=y
CONFIG_EDAC=y
CONFIG_IPMI_HANDLER=y
CONFIG_IPMI_DEVICE_INTERFACE=y
CONFIG_IPMI_SI=y
CONFIG_WATCHDOG=y
CONFIG_SOFT_WATCHDOG=y
CONFIG_ITCO_WDT=y
# ---- broad coverage (operator 2026-11-13)
CONFIG_INTEL_VSEC=m
CONFIG_INTEL_PMT_TELEMETRY=m
CONFIG_INTEL_PMC_CORE=m
CONFIG_SENSORS_NCT6683=m
CONFIG_SENSORS_F71882FG=m
CONFIG_SENSORS_W83627HF=m
CONFIG_SENSORS_JC42=m
CONFIG_SENSORS_ACPI_POWER=m
CONFIG_ACPI_IPMI=m
CONFIG_IPMI_SSIF=m
CONFIG_IPMI_WATCHDOG=m
CONFIG_EDAC_AMD64=m
CONFIG_EDAC_SBRIDGE=m
CONFIG_EDAC_SKX=m
CONFIG_EDAC_I10NM=m
CONFIG_EDAC_IGEN6=m
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS=m
CONFIG_TCG_CRB=m
CONFIG_INTEL_PCH_THERMAL=m
