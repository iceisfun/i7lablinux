#!/usr/bin/env python3
"""Check that every relative markdown link in the tracked docs resolves to an existing file or directory.
usage: check-doc-links          (from anywhere; checks README, CONTRIBUTING, SECURITY, CHANGELOG, docs/**, tests/**/README.md)
External links (http, https, mailto) and pure #anchors are skipped; a #fragment on a file link is ignored.
Exit 0 when all resolve, 1 otherwise."""
import os, re, sys

root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
files = []
for d, dirs, names in os.walk(root):
    dirs[:] = [x for x in dirs if x not in (".git", "target", "keys", "out", "node_modules")]
    for n in names:
        if n.endswith(".md"):
            files.append(os.path.join(d, n))

link = re.compile(r"\[[^\]]*\]\(([^)\s]+)(?:\s+\"[^\"]*\")?\)")
bad = 0
for f in sorted(files):
    in_code = False
    for no, line in enumerate(open(f, encoding="utf-8"), 1):
        if line.lstrip().startswith("```"):
            in_code = not in_code
        if in_code:
            continue
        line = re.sub(r"`[^`]*`", "", line)  # ignore inline code
        for m in link.finditer(line):
            t = m.group(1)
            if re.match(r"^[a-z][a-z0-9+.-]*:", t) or t.startswith("#"):
                continue
            t = t.split("#", 1)[0]
            if not t:
                continue
            p = os.path.normpath(os.path.join(os.path.dirname(f), t))
            if not os.path.exists(p):
                print(f"{os.path.relpath(f, root)}:{no}: broken link {m.group(1)}")
                bad += 1
print("check-doc-links: ok" if not bad else f"check-doc-links: {bad} broken")
sys.exit(1 if bad else 0)
