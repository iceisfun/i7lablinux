#!/usr/bin/env bash
# THE entry point: compile everything, build the image, write it to a USB drive (or an image file) and bake your keys in.
# usage: build-usb-drive /dev/sdX [--serial S] [options]          write a stick (runs on YOUR machine, needs sudo)
#        build-usb-drive --image out/my.img [--iso out/my.iso]     no stick: a keyed image (and ISO for JetKVM) in a file
#   --dry-run          do every build step and every safety check, show the plan, write NOTHING
#   --serial S         must equal the drive's serial (lsblk -dno SERIAL DEV); required with --yes-i-am-sure; NONE = it has none
#   --yes-i-am-sure    skip typing the device name (still needs --serial and prints the size); for scripts
#   --internal         allow a non-removable / non-USB disk (never one that is mounted, holds / or is in use)
#   --no-build         use out/image/i7lablinux.img from the last build;  --from FILE  use that keyless image
#   --build-host H     build host (default $I7LL_HOST, else ~/.config/i7lablinux/build-host), or "local" if this machine can build
#   --keys DIR | --no-keys     key set (default ./keys, then ~/.config/i7labctl/keys); --no-keys leaves the placeholder
#   --variant lean|full   image variant (default lean: < 256 MiB; full: every driver family + all firmware, ~1 GiB, for a stick)
#   --kernel stable|lts   kernel flavour (default stable)
#   FIRMWARE=auto|none     passed to the build (default auto)
#   Safety: refuses mounted devices, the disk holding /, devices in use, partitions, read-only devices, and non-removable
#   disks without --internal; shows model/serial/size/partitions; needs the typed device name or --yes-i-am-sure + --serial.
# Owner: P10. Spec: docs/PLAN.md sections 5, 6, 7; docs/BUILD.md, docs/QUICKSTART.md.
. "$(dirname "$0")/lib/common.sh"

DEV="" IMGOUT="" ISOOUT="" SERIAL="" SURE=0 DRY=0 INTERNAL=0 NOBUILD=0 FROM="" KEYARGS=() BUILDARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --device) DEV="${2:?--device /dev/sdX}"; shift 2;;
    --image) IMGOUT="${2:?--image FILE}"; shift 2;;
    --iso) ISOOUT="${2:?--iso FILE}"; shift 2;;
    --serial) SERIAL="${2:?--serial S}"; shift 2;;
    --yes-i-am-sure|--yes) SURE=1; shift;;
    --dry-run|-n) DRY=1; shift;;
    --internal) INTERNAL=1; shift;;
    --no-build) NOBUILD=1; shift;;
    --from) FROM="${2:?--from FILE}"; NOBUILD=1; shift 2;;
    --build-host) if [ "${2:?}" = local ]; then I7_BUILD_HOST=local; else I7_HOST="$2"; fi; shift 2;;
    --keys) KEYARGS=(--keys "${2:?--keys DIR}"); shift 2;;
    --no-keys) KEYARGS=(--none); shift;;
    --variant|--kernel) BUILDARGS+=("$1" "${2:?$1 needs a value}"); shift 2;;   # lean|full, stable|lts: passed to build-image
    FIRMWARE=*|WIFI=*) BUILDARGS+=("$1"); shift;;
    -h|--help) sed -n '2,19p' "$0"; exit 0;;
    -*) die "unknown option $1 (see --help)";;
    *) [ -z "$DEV" ] || die "two devices given ($DEV and $1)"; DEV="$1"; shift;;
  esac
done
[ -n "$DEV" ] || [ -n "$IMGOUT" ] || die "give a device (/dev/sdX) or --image FILE; --help shows both"
{ [ -z "$DEV" ] || [ -z "$IMGOUT" ]; } || die "a device and --image are alternatives, not both"
[ -z "$ISOOUT" ] || [ -n "$IMGOUT" ] || die "--iso goes with --image (the ISO is always keyless/placeholder otherwise)"
if [ -n "$DEV" ] && [ "$(id -u)" != 0 ]; then need sudo; fi
SUDO=""; [ "$(id -u)" = 0 ] || SUDO="sudo"
need sgdisk sha256sum dd

# ---- 0. key set must exist before we spend minutes building --------------------------------------------------------------------
BAKEKEYS=("$I7_ROOT/scripts/bake-keys")
if [ "${KEYARGS[0]:-}" != --none ]; then
  KD="${KEYARGS[1]:-}"
  [ -n "$KD" ] || { [ -s "$I7_ROOT/keys/admin.key" ] && KD="$I7_ROOT/keys" || KD="$HOME/.config/i7labctl/keys"; }
  [ -s "$KD/admin.key" ] && [ -s "$KD/ro.key" ] || die "no keys in $KD. Run scripts/gen-keys first (or --no-keys for the placeholder)"
  KEYARGS=(--keys "$KD")
fi

# ---- 1. build (or reuse) the keyless image ---------------------------------------------------------------------------------------
if [ -n "$FROM" ]; then SRCIMG="$FROM"
else
  SRCIMG="$I7_OUT/image/i7lablinux.img"
  if [ "$NOBUILD" = 0 ]; then
    info "building on the build host (kernel + userland + initramfs + image); first run takes a few minutes, later runs reuse the kernel cache"
    "$I7_ROOT/scripts/build-image" --full "${BUILDARGS[@]}"
  fi
fi
[ -f "$SRCIMG" ] || die "$SRCIMG not found (drop --no-build, or run scripts/build-image --full)"
SRCIMG="$(readlink -f "$SRCIMG")"
IMGBYTES="$(stat -c%s "$SRCIMG")"
if command -v mcopy >/dev/null 2>&1; then "$I7_ROOT/scripts/check-no-busybox" --image "$SRCIMG" || die "image fails the no-busybox check"
else warn "mtools not installed here: skipped the no-busybox scan of the image (the build host already ran it)"; fi

# ---- image-file mode ------------------------------------------------------------------------------------------------------------
if [ -n "$IMGOUT" ]; then
  info "image file mode: $IMGOUT"
  if [ "$DRY" = 1 ]; then info "dry run: would copy $SRCIMG to $IMGOUT and bake keys (${KEYARGS[*]:-default})"; exit 0; fi
  mkdir -p "$(dirname "$IMGOUT")"
  cp --reflink=auto "$SRCIMG" "$IMGOUT"; chmod 600 "$IMGOUT"
  if [ "${KEYARGS[0]:-}" != --none ]; then "${BAKEKEYS[@]}" --image "$IMGOUT" "${KEYARGS[@]}"; fi
  if [ -n "$ISOOUT" ]; then
    SRCISO="${SRCIMG%.img}.iso"; [ -f "$SRCISO" ] || SRCISO="$(dirname "$SRCIMG")/i7lablinux.iso"
    [ -f "$SRCISO" ] || die "no ISO next to $SRCIMG (build without --no-iso)"
    cp --reflink=auto "$SRCISO" "$ISOOUT"; chmod 600 "$ISOOUT"
    if [ "${KEYARGS[0]:-}" != --none ]; then "${BAKEKEYS[@]}" --iso "$ISOOUT" "${KEYARGS[@]}"; fi
  fi
  info "done: $IMGOUT${ISOOUT:+ and $ISOOUT}. Write with: sudo dd if=$IMGOUT of=/dev/sdX bs=4M conv=fsync status=progress (or use this script with a device)"
  exit 0
fi

# ---- 2. device safety checks (PLAN section 6 spirit: refuse first, ask second) ------------------------------------------------
need lsblk blkid findmnt
refuse() { echo "build-usb-drive: REFUSED: $*" >&2; exit 1; }
[ -b "$DEV" ] || refuse "$DEV is not a block device"
DEV="$(readlink -f "$DEV")"; NAME="${DEV##*/}"; SYS="/sys/block/$NAME"
[ -d "$SYS" ] || refuse "$DEV is not a whole disk (give /dev/sdX, not a partition)"
# I7_TEST_LOOP=1 lets the tests use a loop device (it is never a stick, so this cannot hit real hardware)
TESTLOOP=0; { [ "${I7_TEST_LOOP:-0}" = 1 ] && [[ "$NAME" == loop* ]]; } && TESTLOOP=1
[ "$TESTLOOP" = 1 ] || [ "$(lsblk -dno TYPE "$DEV")" = disk ] || refuse "$DEV is type '$(lsblk -dno TYPE "$DEV")', not disk"
RM="$(lsblk -dno RM "$DEV" | tr -d ' ')" TRAN="$(lsblk -dno TRAN "$DEV" | tr -d ' ')" RO="$(lsblk -dno RO "$DEV" | tr -d ' ')"
MODEL="$(lsblk -dno MODEL "$DEV" | sed 's/ *$//')" HAVESER="$(lsblk -dno SERIAL "$DEV" | tr -d ' ')"
SIZE="$(blockdev --getsize64 "$DEV" 2>/dev/null || echo $(( $(cat "$SYS/size") * 512 )))"
[ "$RO" = 0 ] || refuse "$DEV is read-only"
[ "$SIZE" -ge "$((IMGBYTES + 2097152))" ] || refuse "$DEV is $SIZE bytes, the image needs $IMGBYTES (+ room for the backup GPT)"
if [ "$TESTLOOP" = 1 ]; then :
elif [ "$INTERNAL" = 0 ]; then
  [ "$RM" = 1 ] || refuse "$DEV is not removable (RM=$RM). A USB stick is. An internal or enclosure disk needs --internal"
  [ "$TRAN" = usb ] || refuse "$DEV transport is '$TRAN', not usb. A non-USB disk needs --internal"
  [ "$SIZE" -le 2199023255552 ] || refuse "$DEV is $((SIZE / 1000000000)) GB: too big for a stick; --internal if you mean it"
else
  [ "$SIZE" -le 4100000000000 ] || refuse "$DEV is $((SIZE / 1000000000)) GB, above the 4.1 TB sanity cap"
fi
# the disk we are running from, and anything stacked on it
ROOTSRC="$(findmnt -no SOURCE / 2>/dev/null || true)"
if [ -n "$ROOTSRC" ]; then
  ROOTSRC="$(readlink -f "$ROOTSRC" 2>/dev/null || echo "$ROOTSRC")"
  lsblk -snro NAME "$ROOTSRC" 2>/dev/null | grep -qx "$NAME" && refuse "$DEV is part of the device stack of the root filesystem"
  [ "$ROOTSRC" != "$DEV" ] || refuse "$DEV holds the root filesystem"
fi
# MOUNTPOINT (singular) exists in every lsblk; a failing lsblk must refuse, not read as "nothing mounted"
mounted_on() { local l; l="$(lsblk -nro MOUNTPOINT "$DEV")" || refuse "lsblk cannot list the mount points of $DEV"; printf '%s\n' "$l" | grep . | tr '\n' ' ' || true; }
MNT="$(mounted_on)"
[ -z "$MNT" ] || refuse "$DEV has mounted partitions: $MNT (unmount them first: the script never unmounts for you)"
HOLD="$(find "$SYS/holders" "$SYS/$NAME"*/holders -mindepth 1 2>/dev/null | sed 's|.*/||' | tr '\n' ' ' || true)"
[ -z "$HOLD" ] || refuse "$DEV is in use by $HOLD (device-mapper/md holders)"
while read -r sw; do
  [ -n "$sw" ] || continue
  s="$(readlink -f "$sw" 2>/dev/null || echo "$sw")"; s="${s##*/}"
  lsblk -nro NAME "$DEV" | grep -qx "$s" && refuse "$sw is active swap on $DEV"
done < <(swapon --noheadings --show=NAME 2>/dev/null || true)
FSMEM="$(lsblk -nro FSTYPE "$DEV" | grep -E 'linux_raid_member|LVM2_member|crypto_LUKS|zfs_member' | sort -u | tr '\n' ' ' || true)"
[ -z "$FSMEM" ] || refuse "$DEV carries $FSMEM: refusing to destroy a RAID/LVM/LUKS/ZFS member"
# the serial: the one thing that tells two identical sticks apart
if [ -n "$SERIAL" ] && [ "$SERIAL" != NONE ]; then
  [ "$HAVESER" = "$SERIAL" ] || refuse "serial of $DEV is '${HAVESER:-<none>}', --serial said '$SERIAL'"
elif [ "$SERIAL" = NONE ]; then
  [ -z "$HAVESER" ] || refuse "--serial NONE but $DEV reports serial '$HAVESER'"
fi
[ "$SURE" = 0 ] || [ -n "$SERIAL" ] || refuse "--yes-i-am-sure needs --serial (lsblk -dno SERIAL $DEV), or --serial NONE for a stick without one"
# identity of what was checked: devno, diskseq (new number for every attached disk, Linux >= 5.15), serial, size.
# Re-read right before wiping, so a stick swapped while the prompt waited (same /dev/sdX, other disk) is refused.
ident() { printf '%s|%s|%s|%s' "$(cat "$SYS/dev" 2>/dev/null)" "$(cat "$SYS/diskseq" 2>/dev/null)" "$(lsblk -dno SERIAL "$DEV" 2>/dev/null | tr -d ' ')" "$(cat "$SYS/size" 2>/dev/null)"; }
IDENT="$(ident)"

cat >&2 <<EOF

  Target   : $DEV   ($NAME)
  Model    : ${MODEL:-?}   serial: ${HAVESER:-<none>}   transport: ${TRAN:-?}   removable: $RM
  Size     : $((SIZE / 1000000000)) GB ($SIZE bytes)
  Contents : EVERYTHING on it will be destroyed. Current layout:
EOF
lsblk -o NAME,SIZE,FSTYPE,LABEL,MOUNTPOINT "$DEV" | sed 's/^/             /' >&2
echo "  Image    : $SRCIMG ($((IMGBYTES / 1048576)) MiB), keys: $([ "${KEYARGS[0]:-}" = --none ] && echo "none (placeholder)" || echo "${KEYARGS[*]}")" >&2
echo >&2
if [ "$DRY" = 1 ]; then
  info "dry run: all checks passed. Would: wipefs, dd the image, verify by read-back, sgdisk -e, bake keys, verify the ESP. Nothing was written."
  exit 0
fi
if [ "$SURE" = 1 ]; then
  info "--yes-i-am-sure given: writing $DEV ($((SIZE / 1000000000)) GB, serial ${HAVESER:-none})"
else
  [ -t 0 ] || refuse "no terminal to confirm on: use --yes-i-am-sure --serial ${HAVESER:-NONE} for non-interactive runs"
  printf 'Type the device name (%s) to erase it and write i7lablinux: ' "$DEV" >&2
  read -r ANS
  [ "$ANS" = "$DEV" ] || refuse "you typed '$ANS', not $DEV: nothing written"
fi

# ---- 3. write, verify, bake -----------------------------------------------------------------------------------------------------
[ "$(ident)" = "$IDENT" ] || refuse "$DEV changed since it was checked (another disk now has this name?): nothing written"
MNT="$(mounted_on)"
[ -z "$MNT" ] || refuse "$DEV got mounted partitions while waiting ($MNT): nothing written"
$SUDO wipefs -a "$DEV" >/dev/null   # no --force: wipefs refuses a disk that is in use, and set -e stops us
info "writing $IMGBYTES bytes to $DEV"
$SUDO dd if="$SRCIMG" of="$DEV" bs=4M conv=fsync oflag=direct status=progress
sync
GOT="$($SUDO head -c "$IMGBYTES" "$DEV" | sha256sum | cut -d' ' -f1)"
[ "$GOT" = "$(sha256_file "$SRCIMG")" ] || die "read-back of $DEV differs from the image: the drive is bad or was removed; do not use it"
info "read-back sha256 matches the image"
$SUDO sgdisk -e "$DEV" >/dev/null 2>&1 || warn "sgdisk -e failed (backup GPT stays at the image end; harmless but the tail of the stick is unused)"
$SUDO blockdev --rereadpt "$DEV" 2>/dev/null || $SUDO partprobe "$DEV" 2>/dev/null || true
command -v udevadm >/dev/null 2>&1 && $SUDO udevadm settle 2>/dev/null || sleep 2
if [ "${KEYARGS[0]:-}" != --none ]; then
  "${BAKEKEYS[@]}" --device "$DEV" --serial "${SERIAL:-${HAVESER:-NONE}}" "${KEYARGS[@]}"
fi

# ---- 4. final verification from the stick itself ------------------------------------------------------------------------------------
V="$(mktemp -d)"; trap 'rm -rf "$V"' EXIT
case "$DEV" in *[0-9]) P="${DEV}p2";; *) P="${DEV}2";; esac
if command -v mcopy >/dev/null 2>&1; then
  $SUDO env MTOOLS_SKIP_CHECK=1 mcopy -n -i "$P" ::i7lab/SHA256SUMS - > "$V/SHA256SUMS"
  for f in i7lab/bzImage i7lab/initramfs.cpio.zst; do
    $SUDO env MTOOLS_SKIP_CHECK=1 mcopy -n -i "$P" "::$f" - > "$V/$(basename "$f")"
    want="$(awk -v f="$f" '$2==f{print $1}' "$V/SHA256SUMS")"
    [ -n "$want" ] && [ "$(sha256_file "$V/$(basename "$f")")" = "$want" ] || die "$f on the stick does not match its SHA256SUMS: do not use it"
  done
  info "verified from the stick: kernel and initramfs match SHA256SUMS"
else
  warn "mtools not installed here: skipped the ESP file verification (the raw read-back above already matched)"
fi
info "DONE. Boot the host from this stick; then: i7labctl discover   (docs/REMOTE-BOOT.md for what to tell the person at the machine)"
